"""Bridge gpsd NMEA output to GeoClue's network-nmea Unix socket."""

import grp
import os
import socket
import subprocess

SOCKET_PATH = "/run/yogabook-gnss/nmea.sock"
NMEA_PREFIXES = (b"$GPGGA", b"$GNGGA", b"$GPRMC", b"$GNRMC")

os.makedirs(os.path.dirname(SOCKET_PATH), mode=0o755, exist_ok=True)
try:
    os.unlink(SOCKET_PATH)
except FileNotFoundError:
    pass

server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
server.bind(SOCKET_PATH)
try:
    os.chown(SOCKET_PATH, 0, grp.getgrnam("geoclue").gr_gid)
    os.chmod(SOCKET_PATH, 0o660)
except (KeyError, PermissionError):
    os.chmod(SOCKET_PATH, 0o666)
server.listen(4)

while True:
    connection, _ = server.accept()
    producer = subprocess.Popen(
        ["gpspipe", "-r"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    try:
        while True:
            line = producer.stdout.readline()
            if not line:
                break
            if line.startswith(NMEA_PREFIXES):
                connection.sendall(line)
    except (BrokenPipeError, ConnectionResetError):
        pass
    finally:
        producer.terminate()
        try:
            producer.wait(timeout=2)
        except subprocess.TimeoutExpired:
            producer.kill()
        connection.close()
